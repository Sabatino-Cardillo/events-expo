{
  "expo": {
    "name": "Events Live",
    "slug": "events-expo",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "events-expo",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "./plugins/withNetworkSecurityConfig",
      "expo-web-browser"
    ],
    "android": {
      "package": "com.example.eventslive",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.example.eventslive",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ec000e3-e20b-4aed-9273-64a2f3a575e4"
      }
    }
  }
}
